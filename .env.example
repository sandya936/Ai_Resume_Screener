# AGENTX Environment Variables Template
PROJECT_NAME="AGENTX — Production-Ready AI Resume Intelligence Platform"
ENVIRONMENT="production"

# Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="agentx_user"
POSTGRES_PASSWORD="your_secure_postgres_password_here"
POSTGRES_DB="agentx_db"
DATABASE_URL="postgresql+asyncpg://agentx_user:your_secure_postgres_password_here@localhost:5432/agentx_db"

# JWT Authentication
SECRET_KEY="generate_random_64_character_hex_string_for_production"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Provider Configuration ("mock", "gemini", "openai")
LLM_PROVIDER="mock"
GEMINI_API_KEY="your_google_gemini_api_key_if_using_gemini"
OPENAI_API_KEY="your_openai_api_key_if_using_openai"

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
